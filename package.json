{
  "name": "botc",
  "version": "0.28.0",
  "private": true,
  "description": "My most ambitious Discord bot yet.",
  "scripts": {
    "dev": "node --watch src/app.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "prepare": "husky",
    "start": "node src/app.ts",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jlyons210/botc.git"
  },
  "author": {
    "name": "Jeremy Lyons",
    "email": "jlyons210@gmail.com",
    "url": "https://www.linkedin.com/in/jeremylyons/"
  },
  "license": "Unlicense",
  "bugs": {
    "url": "https://github.com/jlyons210/botc/issues"
  },
  "homepage": "https://github.com/jlyons210/botc#readme",
  "type": "module",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.74.0",
    "discord.js": "14.27.0",
    "openai": "7.43.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-tsdoc": "0.5.4",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
